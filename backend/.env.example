# cp .env.example .env 후 값을 채운다. .env 는 커밋되지 않는다(.gitignore).
# 두 키가 모두 비어 있으면: 메모리 저장소 + 데모 모드(GPT 대신 요약을 그대로 보여 줌)로 뜬다.

# --- OpenAI ---
OPENAI_API_KEY=
# 쓸 모델(기본 gpt-4o-mini). 계정에서 쓸 수 있는 모델명으로 바꿔도 된다
OPENAI_MODEL=gpt-4o-mini
# 답변 1회 최대 토큰 = 과금 상한
OPENAI_MAX_TOKENS=600
# 프록시를 쓸 때만 입력
OPENAI_BASE_URL=

# --- Firebase (둘 중 하나) ---
# 서비스 계정 키 JSON 내용 전체를 한 줄로 (Render 에서는 이 방식)
FIREBASE_SERVICE_ACCOUNT_JSON=
# 또는 로컬에서 키 파일 경로 (저장소 밖 경로 권장)
FIREBASE_SERVICE_ACCOUNT_PATH=

# --- CORS: 프론트 주소(쉼표로 여러 개). 비우면 localhost:5500/3000 만 허용 ---
ALLOWED_ORIGINS=http://localhost:5500

# --- 과금 보호 ---
CHAT_RATE_PER_MINUTE=10
CHAT_DAILY_LIMIT=300
