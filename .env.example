# 이 파일을 .env 로 복사한 뒤 실제 키를 채워 넣으세요.
#   cp .env.example .env
# .env 는 .gitignore 에 등록되어 있어 커밋되지 않습니다.

# Google AI Studio → https://aistudio.google.com/apikey
GEMINI_API_KEY=

# 카카오 개발자센터 → https://developers.kakao.com
#   내 애플리케이션 → 앱 키 → REST API 키
KAKAO_REST_API_KEY=

# (선택) 사용할 Gemini 모델. 비워 두면 gemini-2.5-flash 를 씁니다.
GEMINI_MODEL=
