# 이 파일을 .env 로 복사한 뒤 실제 키를 채워 넣으세요.
#   cp .env.example .env
# .env 는 .gitignore 에 등록되어 있어 커밋되지 않습니다.
# 이 파일(.env.example)은 git 이 추적하므로 실제 키를 적지 마세요.

# API 키
ANTHROPIC_API_KEY=

# 엔드포인트. 비워 두면 api.anthropic.com 을 직접 호출합니다.
# 학습용 프록시를 쓸 때만 주소를 적습니다. 예: https://copa.codyssey.kr
ANTHROPIC_BASE_URL=

# (선택) 모델 ID. 비워 두면 아래 기본값을 씁니다.
#   revise → claude-sonnet-4 / assist → claude-haiku-4
MODEL_REVISE=
MODEL_ASSIST=
